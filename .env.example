# ─── Broker ────────────────────────────────────────────────────────────────────
# Hostname pada SAN sertifikat server dan yang dipakai client untuk verifikasi TLS.
# TBC: domain/DNS broker belum diputuskan.
RAIN_BROKER_HOST=mqtt-poc.example.test

# URL broker untuk client Go. Hari uji memakai tls:// port 8883.
RAIN_MQTT_URL=tls://mqtt-poc.example.test:8883

# Kredensial client. Satu client fisik di plant: ems-pv-01 (TF6701).
RAIN_MQTT_USER=ems-pv-01
RAIN_MQTT_PASS=

# CA internal yang menandatangani sertifikat broker. File ini yang dikirim ke tim OT.
# TBC: CA internal vs Let's Encrypt.
RAIN_MQTT_CA=deploy/certs/out/ca.crt

# Client certificate — opsional, dipakai hanya kalau broker diset mutual TLS.
RAIN_MQTT_CLIENT_CERT=
RAIN_MQTT_CLIENT_KEY=

# ─── Database ──────────────────────────────────────────────────────────────────
RAIN_PG_DSN=postgres://rain:rain@127.0.0.1:5432/rain?sslmode=disable

# ─── Ingest ────────────────────────────────────────────────────────────────────
# Alamat /healthz dan /metrics.
RAIN_HTTP_ADDR=127.0.0.1:8080

# ─── Bootstrap broker (dipakai deploy/emqx/bootstrap.sh, bukan oleh binari Go) ──
# Password tiga user built-in. Kosongkan di repo; isi di .env yang tidak di-commit.
RAIN_EMS_PV_PASS=
RAIN_INGEST_PASS=
RAIN_SIM_PASS=

# Kredensial dashboard EMQX (hanya bind 127.0.0.1, akses lewat SSH tunnel).
RAIN_EMQX_DASHBOARD_USER=admin
RAIN_EMQX_DASHBOARD_PASS=

# ─── Postgres container ────────────────────────────────────────────────────────
RAIN_PG_USER=rain
RAIN_PG_PASS=rain
RAIN_PG_DB=rain

# ─── Port di host (ubah kalau bentrok dengan layanan lain di mesin) ────────────
RAIN_MQTT_HOST_PORT=8883
RAIN_MQTT_PLAIN_HOST_PORT=1883
RAIN_EMQX_DASHBOARD_HOST_PORT=18083
RAIN_PG_HOST_PORT=5432
RAIN_INGEST_HTTP_PORT=8080

# ─── Opsional ──────────────────────────────────────────────────────────────────
# Cookie cluster Erlang. Satu node saja, jadi nilainya bebas asal konsisten.
RAIN_EMQX_COOKIE=rain-poc-cookie

# Kalau TF6701 menyambung ke alamat IP dan bukan ke nama DNS, isi di sini supaya
# IP-nya ikut masuk SAN sertifikat server.
RAIN_BROKER_IP=

# clientId ingest. Harus tetap: broker memakainya untuk menyimpan sesi QoS 1
# selama ingest restart.
RAIN_INGEST_CLIENT_ID=ingest

# Log. RAIN_LOG_FORMAT=console untuk terbaca manusia, json untuk log collector.
# Kosong = otomatis (console kalau terminal).
RAIN_LOG_LEVEL=info
RAIN_LOG_FORMAT=

# Umur sertifikat dan client cert opsional (dipakai deploy/certs/make-certs.sh).
RAIN_CERT_DAYS_CA=3650
RAIN_CERT_DAYS_LEAF=825
RAIN_CLIENT_CN=ems-pv-01
RAIN_MAKE_CLIENT_CERT=1
